# ============================================
# PULSE - Event Booking SaaS Starter Kit
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----- Database -----
# PostgreSQL connection string (Neon, Supabase, Railway, or local)
# Get a free database at https://neon.tech
DATABASE_URL="postgresql://username:password@host:5432/dbname?sslmode=require"

# ----- Authentication -----
# Generate a random secret: npx auth secret
AUTH_SECRET="your-random-secret-here"

# ----- App URL -----
# Your production URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Stripe -----
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ----- Resend (Email) -----
# Get your API key at https://resend.com/api-keys
# Free tier: 100 emails/day
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="PULSE <onboarding@resend.dev>"
